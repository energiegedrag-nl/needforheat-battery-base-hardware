		(uuid "b2e32639-cdee-520d-b856-00b416f41a31"))
	(text "U2 TP4056: 60 mA (R3 = 20k: I = 1200 V / R3), CC/CV to 4.2 V, ~STDBY low = charge done (C/10)."
		(exclude_from_sim no)
		(at 264.16 96.52 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "3945d250-b67d-5c96-aab6-0ad7c33c3eb4"))
	(text "PROG voltage = 1.0 V x I / 60 mA: the firmware reads the charge current there (block 5)."
		(exclude_from_sim no)
		(at 264.16 99.06 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "ed1a7dee-5ced-58d6-9865-ff2eec322f9d"))
	(text "Q7/Q8: the TP4056 is cut off from the CoreInk battery (VLIPO) while not charging, so no current"
		(exclude_from_sim no)
		(at 264.16 101.6 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "e5659b3d-b1f9-5e2c-88a7-03d4c2eb961b"))
	(text "leaks out of the LiPo into the unpowered charger (the TP4056 alone allows up to 2 uA)."
		(exclude_from_sim no)
		(at 264.16 104.14 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "e959666f-8028-550e-871d-194f20633c3c"))
