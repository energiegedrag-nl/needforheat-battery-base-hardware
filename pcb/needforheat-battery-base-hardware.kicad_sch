	(text "Off: Q2 off (R10), EN low (R12): boost, charger"
		(exclude_from_sim no)
		(at 172.72 137.16 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "2cc1faf8-e88f-5d42-9a45-a776b4556366"))
	(text "and Q7 off. The latch draws nothing (FET gates)."
		(exclude_from_sim no)
		(at 172.72 139.7 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "dbb62276-f2f4-5c4d-a08a-8cd7263e2a97"))
	(text "On: Q2 pulls EN up (R11). EN holds Q3 on through"
		(exclude_from_sim no)
		(at 172.72 142.24 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "b20f39ea-6266-5fae-8a2e-54bf44deb543"))
	(text "R13 (C5: 0.1 s); Q3 keeps Q2's gate low (R14)."
		(exclude_from_sim no)
		(at 172.72 144.78 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "68769e2c-faf3-52f0-a01c-9a0129725b78"))
	(text "Set: a FORCE pulse (>= 300 ms) from the firmware (Q4), or U3"
		(exclude_from_sim no)
		(at 172.72 147.32 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "76498a9e-6a52-5a3a-b086-3a5002646ed6"))
	(text "when the LiPo is below 3.5 V (released at 3.7 V,"
		(exclude_from_sim no)
		(at 172.72 149.86 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "cedd129a-61e4-5573-8c9d-03f63aaef48c"))
	(text "well under full)."
		(exclude_from_sim no)
		(at 172.72 152.4 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "8f9fb4df-cd8f-5940-966e-50e0464305f5"))
	(text "Reset: ~STDBY (done) pulls HG low through R17;"
		(exclude_from_sim no)
		(at 172.72 154.94 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "2fd811a1-24ca-58b6-b1f0-524b869aa8d3"))
	(text "C5 rides through the undefined ~STDBY while the"
		(exclude_from_sim no)
		(at 172.72 157.48 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "0f6b6cac-528e-53dd-9dc0-29fb470e517a"))
	(text "TP4056 powers up. INHIBIT (Q5) pulls EN low."
		(exclude_from_sim no)
		(at 172.72 160.02 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "85412532-9bf2-580c-b05d-dfa54f4f9e85"))
	(text "U4: cells below 2.8 V -> Q6 pulls HOLDG up:"
		(exclude_from_sim no)
		(at 172.72 162.56 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "0cd4b5a5-7bb4-5129-a6dd-bde63a97afb2"))
	(text "no start, a running charge stops."
		(exclude_from_sim no)
		(at 172.72 165.1 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "c408523f-41fa-5df9-af25-30aa18464b12"))
	(text "Off-state: U3 0.3 uA (LiPo), U4 0.3 uA and U1"
