	(text "U1 TPS61023: VOUT = 0.595 V x (1 + R1/R2) = 4.71 V; just above the 4.2 V the charger needs,"
		(exclude_from_sim no)
		(at 142.24 88.9 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "81c29460-0533-509f-b623-6f49a9871506"))
	(text "so the linear charger (block 3) loses little: about 0.9 x 4.0/4.7 = 77 % from the cells to the LiPo."
		(exclude_from_sim no)
		(at 142.24 91.44 0)
		(effects
