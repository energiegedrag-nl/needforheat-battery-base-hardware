	(text "Three AAA cells in series: GND (BC2) - cell 1 - N12 (BC1 = BC3) - cell 2 - N23 (BC4 = BC5) - cell 3 - BAT_RAW (BC6)."
		(exclude_from_sim no)
		(at 20.32 96.52 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "9beda060-62b1-5962-9157-4ae7a0632f34"))
	(text "Contacts: MYOUNG MY-AAA-15-J (+ plate) and MY-AAA-16-J (- spring), tabs soldered in PCB slots (THT);"
		(exclude_from_sim no)
		(at 20.32 99.06 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "21770e07-574b-5395-8931-d460dfc18506"))
	(text "they stand on the PCB's back side and lean on the printed cradle. The spring is always the minus end."
		(exclude_from_sim no)
		(at 20.32 101.6 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "a968d1af-9bd7-5743-8108-4e77bcbf27a1"))
	(text "Q1: reverse-polarity protection (the whole pack in backwards). VCELL = 2.7 ... 4.8 V (alkaline), 3.0 ... 4.2 V (NiMH)."
		(exclude_from_sim no)
		(at 20.32 104.14 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "06995703-2b57-5ebe-bccc-1a78d8f70aef"))
	(text "No current flows from the cells unless the latch (block 4) switches the boost on: about 0.4 uA in total."
		(exclude_from_sim no)
		(at 20.32 106.68 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "a0950db2-24e8-538b-9281-d61ab961fac3"))
