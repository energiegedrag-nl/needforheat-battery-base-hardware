		(at 172.72 167.64 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "a0da7205-d354-508c-af9f-f3f5f736846d"))
	(text "0.1 uA (cells). Simulated: docs/simulation."
