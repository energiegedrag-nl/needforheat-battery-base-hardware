			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "997f16e5-6678-5870-9e67-cbc8512e88fe"))
	(text "U3 TPS3840DL35: safety net for a CoreInk without BatteryBASE firmware. The normal start is the firmware's FORCE pulse below"
		(exclude_from_sim no)
		(at 20.32 228.6 0)
		(effects
