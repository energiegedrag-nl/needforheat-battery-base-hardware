	(label "HOLDG"
		(at 195.58 185.42 90)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "e0d51477-2056-538e-9b74-19d2d1c08f5a"))
	(text "Off: Q2 off (R10), EN low (R12), everything off; the latch itself draws nothing (gates only)."
		(exclude_from_sim no)
		(at 20.32 215.9 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "2ae4c86a-2e39-552d-a817-37306cc46b8a"))
	(text "On: Q2 pulls EN up (R11) -> U1 boost, Q8/Q7 connect the charger; EN holds Q3 on through R13 (C5: 0.1 s),"
		(exclude_from_sim no)
		(at 20.32 218.44 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "85e0ef8e-d952-5599-b2d6-4c95a2ad3d70"))
	(text "Q3 keeps Q2's gate low through R14. Set: FORCE pulse from the firmware (Q4), or U3 (TPS3840DL35) when the"
		(exclude_from_sim no)
		(at 20.32 220.98 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "651d2cbf-f9fe-5944-b279-07f79c333823"))
	(text "LiPo is below 3.5 V (released at 3.7 V, well under full). Reset: ~STDBY (done) pulls HG low through R17;"
		(exclude_from_sim no)
		(at 20.32 223.52 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "ea61f2c7-96e1-59e0-b367-4519bda01d4c"))
	(text "C5 rides through the undefined ~STDBY while the TP4056 powers up. INHIBIT (Q5) pulls EN low. U4 (TPS3840DL28):"
		(exclude_from_sim no)
		(at 20.32 226.06 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "f1cbe795-3596-5683-8186-aff8bbd3836b"))
	(text "cells below 2.8 V -> Q6 pulls HOLDG up: no start, a running charge stops. Off-state current: U3 0.3 uA"
		(exclude_from_sim no)
		(at 20.32 228.6 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "35fc1f5b-7e98-57e4-81de-018eb8d3eefd"))
	(text "(from the LiPo), U4 0.3 uA and U1 0.1 uA (from the cells). Simulated: docs/simulation."
		(exclude_from_sim no)
		(at 20.32 231.14 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left bottom))
		(uuid "a599ce0c-ffc3-54c5-b9ad-947cf4fc4b7b"))
